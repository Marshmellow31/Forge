{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "lib",
    // `rootDir` reaches one level up so the app's pure judging engine compiles
    // into this bundle rather than being copied into it. See the note in
    // src/index.ts: a duplicated aggregation is a correctness hazard, because a
    // participant would see one score while the leaderboard showed another.
    "rootDir": "..",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "sourceMap": true
  },
  "include": ["src", "../src/core/judging/aggregate.ts"],
  "exclude": ["../src/core/judging/*.test.ts"]
}
