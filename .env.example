# Firebase web config. Copy to .env.local and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These are PUBLIC values. They are safe in a client bundle and safe to commit
# to .env.example. Access is controlled by firestore.rules, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The organization the public demo reads from. Must match what `npm run seed`
# wrote — the seed script defaults to org_demo.
VITE_DEMO_ORG_ID=org_demo

# Point the SDK at a local emulator suite instead of production.
VITE_USE_EMULATOR=false

# The key that reveals the admin panel at /admin. See ADR-024.
#
# Despite the name this is NOT a secret: like every VITE_ variable it is
# compiled into the client bundle and is readable by anyone who opens devtools.
# It decides who is *shown* the admin console. What anyone can actually change
# is decided by their membership document and firestore.rules, which this value
# has no influence over. Change it per deployment; treat a leak as a nuisance,
# not a breach.
VITE_ADMIN_SECRET=forge2026
