# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic data (e.g. node_modules)
node_modules
.pnp
.pnp.js

# Output directory
dist
dist-ssr

# Local env files
*.local
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel
.vercel

# Firebase service account keys — NEVER commit these.
# They grant full admin access to the project and bypass all security rules.
serviceAccountKey.json
*-firebase-adminsdk-*.json
.firebase/
firebase-debug.log

# TypeScript incremental build cache — a build artifact, not source.
tsconfig.tsbuildinfo
*.tsbuildinfo

# Vite PWA build output (generated by `npm run build`)
dev-dist

# Cloud Functions build output and deps (functions/ is not deployed on Spark)
functions/lib
functions/node_modules

# Every local env file, including mode-specific ones (.env.emulator.local).
.env*.local

# Local agent tooling. This branch renamed .claude/ to .agent/; the launch
# config is recreated locally by whatever harness needs it and should not
# come back into version control and undo that.
/.claude/
